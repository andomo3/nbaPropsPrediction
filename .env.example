SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Inside Docker Compose use service hostnames (db, redis).
# Running Django locally outside Docker: replace db→localhost and redis→localhost.
DATABASE_URL=postgres://postgres:postgres@db:5432/nba_props
REDIS_URL=redis://redis:6379/0
ODDS_API_KEY=your-key-from-the-odds-api.com
MODEL_DIR=data/models

# Optional — deployment only. Defaults are fine for local dev.
# CRON_SECRET protects /cron/daily/<secret>/ (endpoint rejects everything while unset).
# CRON_SECRET=
# CORS defaults to the Vite dev server (localhost:5173) when unset.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# PICKS_MIN_CONFIDENCE=0.55
POSTGRES_DB=nba_props
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
