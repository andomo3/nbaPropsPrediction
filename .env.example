SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Inside Docker Compose use service hostnames (db, redis).
# Running Django locally outside Docker: replace db→localhost and redis→localhost.
DATABASE_URL=postgres://postgres:postgres@db:5432/nba_props
REDIS_URL=redis://redis:6379/0
ODDS_API_KEY=your-key-from-the-odds-api.com
MODEL_DIR=data/models
POSTGRES_DB=nba_props
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
